{
  "$schema":"https://openapi.vercel.sh/vercel.json",
  "rewrites":[
    {"source":"/","destination":"/teacher.html"},
    {"source":"/teacher","destination":"/teacher.html"},
    {"source":"/join","destination":"/student.html"},
    {"source":"/student","destination":"/student.html"},
    {"source":"/projector","destination":"/projector.html"}
  ],
  "headers":[
    {"source":"/teacher.js","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/app.js","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/questions.js","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/teacher.html","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/student.html","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
    {"source":"/projector.html","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]}
  ]
}